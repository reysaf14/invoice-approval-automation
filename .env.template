# ==========================================
# n8n Core Configuration
# ==========================================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_strong_password

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# NOTE(A4/A1): BASE URL only - do NOT append /webhook suffix
WEBHOOK_URL=http://localhost:5678
GENERIC_TIMEZONE=Asia/Jakarta

# Queue Mode (Production)
N8N_MODE=queue
EXECUTIONS_MODE=queue

# Encryption Key (REQUIRED for queue mode)
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32

# ==========================================
# PostgreSQL (n8n v1.60 naming convention)
# ==========================================
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=changeme_postgres_password

# ==========================================
# Redis (Queue)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# Google Cloud / Workspace
# ==========================================
# Service Account JSON path (mount to /home/node/.gcp/sa-key.json in container)
GOOGLE_APPLICATION_CREDENTIALS=/home/node/.gcp/sa-key.json

# OAuth Client (for n8n Google credentials)
GOOGLE_CLIENT_ID=your-project.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5678/oauth2/callback

# Target Spreadsheet & Drive Folder
GOOGLE_SHEETS_SPREADSHEET_ID=1AbCdefGhIjKlMnOpQrStUvWxYz_1234567890
GOOGLE_DRIVE_FOLDER_ID=1XyZabcDefGhIjKlMnOpQrStUvWxYz_0987654321

# ==========================================
# Google Document AI (Enterprise OCR)
# ==========================================
GOOGLE_DOC_AI_PROJECT_ID=your-gcp-project-id
GOOGLE_DOC_AI_LOCATION=asia-southeast1
GOOGLE_DOC_AI_PROCESSOR_ID=your-ocr-processor-id

# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_OWNER_CHAT_ID=123456789
TELEGRAM_ADMIN_CHAT_ID=987654321

# ==========================================
# Webhook Security (HMAC)
# ==========================================
# Generate: openssl rand -hex 32
WEBHOOK_HMAC_SECRET=changeme_32_byte_hex_secret_here
WEBHOOK_TIMESTAMP_TOLERANCE=300

# ==========================================
# Optional: Email Fallback (SMTP)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Invoice Bot <noreply@yourdomain.com>